<odoo>
  <data>
    <!-- VISTA CLIENTE - TREE -->
    <record id="dronify_cliente_tree" model="ir.ui.view">
      <field name="name">dronify.cliente.tree</field>
      <field name="model">res.partner</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="es_cliente"/>
          <field name="es_vip" attrs="{'invisible': [('es_cliente', '=', False)]}"/>
        </tree>
      </field>
    </record>
    <!-- VISTA CLIENTE - FORM -->
    <record id="dronify_cliente_form" model="ir.ui.view">
      <field name="name">dronify.cliente.form</field>
      <field name="model">res.partner</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name"/>
              <field name="es_cliente"/>
              <field name="es_vip" attrs="{'invisible': [('es_cliente', '=', False)]}"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <!-- ACTION CLIENTE -->
    <record id="dronify_cliente_action" model="ir.actions.act_window">
      <field name="name">Clientes</field>
      <field name="res_model">res.partner</field>
      <field name="view_mode">tree,form</field>
      <field name="domain">[('es_cliente', '=', True)]</field>
      <field name="view_id" ref="dronify_cliente_tree"/>
    </record>
    <!-- VISTA PILOTO - TREE -->
    <record id="dronify_piloto_tree" model="ir.ui.view">
      <field name="name">dronify.piloto.tree</field>
      <field name="model">res.partner</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="es_piloto"/>
          <field name="es_vip" attrs="{'invisible': [('es_cliente', '=', False)]}"/>
          <field name="licencia"/>
        </tree>
      </field>
    </record>
    <!-- VISTA PILOTO - FORM -->
    <record id="dronify_piloto_form" model="ir.ui.view">
      <field name="name">dronify.piloto.form</field>
      <field name="model">res.partner</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name"/>
              <field name="es_piloto"/>
              <field name="es_vip" attrs="{'invisible': [('es_cliente', '=', False)]}"/>
              <field name="licencia"attrs="{'invisible': [('es_piloto', '=', False)], 'required': [('es_piloto', '=', True)]}"/>/>
            </group>
            <group string="Drones autorizados">
              <field name="dron_autorizado_ids" widget="many2many_tags"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <!-- ACTION PILOTO -->
    <record id="dronify_piloto_action" model="ir.actions.act_window">
      <field name="name">Piloto</field>
      <field name="res_model">res.partner</field>
      <field name="view_mode">tree,form</field>
      <field name="domain">[('es_piloto', '=', True)]</field>
      <field name="view_id" ref="dronify_piloto_tree"/>
    </record>
    <!-- VISTA PAQUETE -->
    <record id="dronify_paquete_tree" model="ir.ui.view">
      <field name="name">dronify.paquete.tree</field>
      <field name="model">dronify.paquete</field>
      <field name="arch" type="xml">
        <tree>
          <field name="codigo"/>
          <field name="name"/>
          <field name="peso"/>
          <field name="cliente_id"/>
          <field name="vuelo_id"/>
          <field name="dron_relacionado"/>
        </tree>
      </field>
    </record>
    <!-- ACTION PAQUETE -->
    <record id="dronify_paquete_action" model="ir.actions.act_window">
      <field name="name">Paquetes</field>
      <field name="res_model">dronify.paquete</field>
      <field name="view_mode">tree</field>
      <field name="view_id" ref="dronify_paquete_tree"/>
    </record>
    <!-- MENÚ ROOT + CLIENTES + PAQUETE -->
    <menuitem id="dronify_menu_root" name="Dronify" sequence="10"/>
    <menuitem id="dronify_menu_clientes" name="Clientes" parent="dronify_menu_root" action="dronify_cliente_action" sequence="10"/>
    <menuitem id="dronify_menu_pilotos" name="Pilotos" parent="dronify_menu_root" action="dronify_piloto_action" sequence="10"/>
    <menuitem id="dronify_menu_paquetes" name="Paquetes" parent="dronify_menu_root" action="dronify_paquete_action" sequence="20"/>
  </data>
</odoo>