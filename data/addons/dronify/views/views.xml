<odoo>
  <data>
    <!-- VISTA CLIENTE - list -->
    <record id="dronify_cliente_list" model="ir.ui.view">
      <field name="name">dronify.cliente.list</field>
      <field name="model">res.partner</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="es_cliente"/>
          <field name="es_vip"/>
        </list>
      </field>
    </record>
    <!-- VISTA CLIENTE - FORM -->
    <record id="dronify_cliente_form" model="ir.ui.view">
      <field name="name">dronify.cliente.form</field>
      <field name="model">res.partner</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name"/>
              <field name="es_cliente"/>
              <field name="es_vip"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <!-- ACTION CLIENTE -->
    <record id="dronify_cliente_action" model="ir.actions.act_window">
      <field name="name">Clientes</field>
      <field name="res_model">res.partner</field>
      <field name="view_mode">list,form</field>
      <field name="domain">[('es_cliente', '=', True)]</field>
      <field name="view_id" ref="dronify_cliente_list"/>
      <field name="context">{'default_es_cliente': True}</field>
    </record>
    <!-- VISTA PILOTO - list -->
    <record id="dronify_piloto_list" model="ir.ui.view">
      <field name="name">dronify.piloto.list</field>
      <field name="model">res.partner</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="es_piloto"/>
          <field name="es_vip"/>
          <field name="licencia" domain="[('es_piloto', '=', True)]"/>
        </list>
      </field>
    </record>
    <!-- VISTA PILOTO - FORM -->
    <record id="dronify_piloto_form" model="ir.ui.view">
      <field name="name">dronify.piloto.form</field>
      <field name="model">res.partner</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name"/>
              <field name="es_piloto" readonly="1"/>
              <field name="es_vip"/>
              <field name="licencia"/>
            </group>
            <group string="Drones autorizados">
              <field name="dron_autorizado_ids" widget="many2many_tags"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <!-- ACTION PILOTO -->
    <record id="dronify_piloto_action" model="ir.actions.act_window">
      <field name="name">Piloto</field>
      <field name="res_model">res.partner</field>
      <field name="view_mode">list,form</field>
      <field name="domain">[('es_piloto', '=', True)]</field>
      <field name="view_id" ref="dronify_piloto_list"/>
      <field name="context">{'default_es_piloto': True}</field>
    </record>
    <!-- VISTA PAQUETE -->
    <record id="dronify_paquete_list" model="ir.ui.view">
      <field name="name">dronify.paquete.list</field>
      <field name="model">dronify.paquete</field>
      <field name="arch" type="xml">
        <list>
          <field name="codigo"/>
          <field name="name"/>
          <field name="peso"/>
          <field name="cliente_id"/>
          <field name="vuelo_id"/>
          <field name="dron_relacionado"/>
        </list>
      </field>
    </record>
    <!-- ACTION PAQUETE -->
    <record id="dronify_paquete_action" model="ir.actions.act_window">
      <field name="name">Paquetes</field>
      <field name="res_model">dronify.paquete</field>
      <field name="view_mode">list</field>
      <field name="view_id" ref="dronify_paquete_list"/>
    </record>
    <!-- VISTA DRON - list -->
    <record id="dronify_dron_list" model="ir.ui.view">
      <field name="name">dronify.dron.list</field>
      <field name="model">dronify.dron</field>
      <field name="arch" type="xml">
        <list decoration-danger="bateria &lt; 25 or estado == 'en_vuelo'" 
          decoration-success="estado == 'disponible'" 
          decoration-warning="estado == 'taller'">
          <field name="name"/>
          <field name="capacidad_max"/>
          <field name="bateria" widget="progressbar"/>
          <field name="estado" widget="badge"/>
        </list>
      </field>
    </record>
    <!-- ACTION DRON -->
    <record id="dronify_dron_action" model="ir.actions.act_window">
      <field name="name">Drones</field>
      <field name="res_model">dronify.dron</field>
      <field name="view_mode">list</field>
      <field name="view_id" ref="dronify_dron_list"/>
    </record>
    <!-- VISTA ZONA - list -->
    <record id="dronify_zona_list" model="ir.ui.view">
      <field name="name">dronify.zona.list</field>
      <field name="model">dronify.zona</field>
      <field name="arch" type="xml">
        <list
            decoration-success="nivel_riesgo in ('1','2')"
            decoration-info="nivel_riesgo == '3'"
            decoration-warning="nivel_riesgo == '4'"
            decoration-danger="nivel_riesgo == '5'">
          <field name="name"/>
          <field name="distancia_km"/>
          <field name="nivel_riesgo" widget="badge"/>
          <field name="tarifa_base"/>
        </list>
      </field>
    </record>
    <!-- ACTION ZONA -->
    <record id="dronify_zona_action" model="ir.actions.act_window">
      <field name="name">Zonas</field>
      <field name="res_model">dronify.zona</field>
      <field name="view_mode">list</field>
      <field name="view_id" ref="dronify_zona_list"/>
    </record>
    <!-- VISTA VUELOS - list -->
    <record id="dronify_vuelo_list" model="ir.ui.view">
      <field name="name">dronify.vuelo.list</field>
      <field name="model">dronify.vuelo</field>
      <field name="arch" type="xml">
        <list>
          <field name="codigo"/>
          <field name="name"/>
          <field name="dron_id"/>
          <field name="piloto_id"/>
          <field name="peso_total"/>
          <field name="consumo_estimado" widget="percentpie"/>
          <field name="preparado" widget="boolean" class="text-center"/>
          <field name="realizado" widget="boolean" class="text-center"/>
        </list>
      </field>
    </record>
    <!-- VISTA VUELOS - form -->
    <record id="dronify_vuelo_form" model="ir.ui.view">
      <field name="name">dronify.vuelo.form</field>
      <field name="model">dronify.vuelo</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <!-- Botones de acción -->
            <button name="action_preparar_vuelo" string="Preparar vuelo" type="object" class="oe_highlight"/>
            <button name="action_desbloquear_vuelo" string="Desbloquear vuelo" type="object" class="oe_highlight"/>
            <button name="action_finalizar_vuelo" string="Finalizar vuelo" type="object" class="oe_highlight"/>
          </header>
          <sheet>
            <group>
              <field name="codigo"/>
              <field name="name"/>
              <field name="dron_id"/>
              <field name="piloto_id"/>
              <field name="peso_total"/>
              <field name="consumo_estimado" widget="percentpie"/>
              <field name="preparado" widget="boolean" class="text-center"/>
              <field name="realizado" widget="boolean" class="text-center"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>
    <!-- ACTION VUELOS list -->
    <record id="dronify_vuelo_action" model="ir.actions.act_window">
      <field name="name">Vuelos</field>
      <field name="res_model">dronify.vuelo</field>
      <field name="view_mode">list,form</field>
      <field name="view_id" ref="dronify_vuelo_list"/>
    </record>
    <!-- VISTA VUELOS - FORM -->
    <record id="dronify_vuelo_form" model="ir.ui.view">
      <field name="name">dronify.vuelo.form</field>
      <field name="model">dronify.vuelo</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <button name="action_preparar_vuelo"/>
            <!-- implementar -->
            <button name="action_desbloquear_vuelo"/>
            <!-- implementar -->
            <button name="action_finalizar_vuelo"/>
            <!-- implementar -->
          </header>
          <sheet>
            <group string="Planificación">
              <!-- name, dron_id, piloto_id, zona_id -->
            </group>
            <group string="Estado y Control">
              <!-- preparado, realizado, peso_total, consumo_estimado -->
            </group>
            <notebook>
              <page string="Paquetes">
                <!-- one2many paquetes_ids -->
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>
    <!-- MENÚ ROOT + RESTO -->
    <menuitem id="dronify_menu_root" name="Dronify" sequence="10"/>
    <menuitem id="dronify_menu_clientes" name="Clientes" parent="dronify_menu_root" action="dronify_cliente_action" sequence="10"/>
    <menuitem id="dronify_menu_pilotos" name="Pilotos" parent="dronify_menu_root" action="dronify_piloto_action" sequence="10"/>
    <menuitem id="dronify_menu_paquetes" name="Paquetes" parent="dronify_menu_root" action="dronify_paquete_action" sequence="20"/>
    <menuitem id="dronify_menu_drones" name="Drones" parent="dronify_menu_root" action="dronify_dron_action" sequence="20"/>
    <menuitem id="dronify_menu_zonas" name="Zonas" parent="dronify_menu_root" action="dronify_zona_action" sequence="20"/>
    <menuitem id="dronify_menu_vuelos" name="Vuelos" parent="dronify_menu_root" action="dronify_vuelo_action" sequence="20"/>
  </data>
</odoo>